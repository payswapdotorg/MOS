{
  "name": "mos-console",
  "version": "1.5.0",
  "private": true,
  "description": "MOS product console — the Next.js presentation layer over the MOS platform API. Recovered original source (P0-SRC / UI-001); presentation only, zero authority state.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build:bundle": "bun mos-build/build-bundle.mjs",
    "build": "bun run build:bundle && next build",
    "start": "next start -p 3000",
    "deploy:preview": "bunx vercel build && bunx vercel deploy --prebuilt --yes",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No component tests exist in the recovered console source (P0 source-recovery scope — see README.md §Testing)\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@tanstack/react-query": "5.90.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.525.0",
    "next": "16.1.3",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "vaul": "1.1.2",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "25.0.9",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.3",
    "eslint-plugin-react-hooks": "7.0.1",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
